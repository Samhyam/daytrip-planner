{
  "name": "daytrip-planner",
  "private": false,
  "version": "1.1.0",
  "description": "A day-trip planner with an AI itinerary generator, independent quality critic, and offline demo mode.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test:unit": "vitest run tests/unit --reporter=json --outputFile=tests/reports/unit.json",
    "test:backend": "python tests/run_backend_tests.py",
    "test:integration": "vitest run --config vitest.integration.config.mjs",
    "test:e2e": "playwright test",
    "test:all": "node tests/run-harness.cjs",
    "test:dashboard": "node tests/dashboard/server.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.0"
  }
}
